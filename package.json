{
  "name": "ia-do-zero",
  "private": true,
  "version": "0.1.0",
  "description": "Curso interativo de inteligência artificial em português, sem backend e sem chamada de API.",
  "license": "MIT",
  "author": "Rui Valim",
  "homepage": "https://ruivalim.github.io/ia-do-zero/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ruivalim/ia-do-zero.git"
  },
  "bugs": "https://github.com/Ruivalim/ia-do-zero/issues",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build && cp dist/index.html dist/404.html && touch dist/.nojekyll",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check": "node scripts/check-content.mjs",
    "paper": "node scripts/new-paper.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md}\""
  },
  "dependencies": {
    "katex": "^0.16.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@mdx-js/react": "^3.1.0",
    "@mdx-js/rollup": "^3.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.6",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
